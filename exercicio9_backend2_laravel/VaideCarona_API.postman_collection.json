					"name": "Login_usuario",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let resposta = pm.response.json();\r",
									"\r",
									"let token = resposta.token; \r",
									"\r",
									"console.log(\"Token encontrado:\", token);\r",
									"\r",
									"//autenticacao com token valido (sem expiracao)\r",
									"\r",
									"\r",
									"if (token) {\r",
									"    pm.environment.set(\"auth\", token); \r",
									"    console.log(\"Token salvo com sucesso!\");\r",
									"} else {\r",
									"    console.log(\"Token não encontrado!\");\r",
									"}"
